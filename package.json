{
  "name": "obsidian-zotero-annotations",
  "version": "0.6.1",
  "description": "Show the Zotero annotations of the paper under the cursor in a sidebar, and keep literature notes in sync with Zotero notes, in both directions.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "zotero",
    "annotations"
  ],
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.14.4",
    "typescript": "~6.0"
  }
}
